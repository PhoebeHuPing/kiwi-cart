# ===========================================
# KiwiCart Java Backend - Azure Environment Variables
# ===========================================
# Configure these in Azure App Service → Configuration → Application Settings

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=prod

# --- Azure App Service Port ---
WEBSITES_PORT=8080

# --- Auth0 Configuration ---
AUTH0_DOMAIN=https://your-tenant.au.auth0.com/
AUTH0_AUDIENCE=https://kiwicart/api

# --- PostgreSQL Database ---
# Azure Database for PostgreSQL connection string
DATABASE_URL=jdbc:postgresql://your-server.postgres.database.azure.com:5432/kiwicart?sslmode=require
DB_USER=kiwicart@your-server
DB_PASSWORD=your-secure-password

# --- Optional: Override rate limit (default: 60/min) ---
# APP_RATE_LIMIT_REQUESTS_PER_MINUTE=60
