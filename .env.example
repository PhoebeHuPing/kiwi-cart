# ===========================================
# KiwiCart Environment Configuration
# ===========================================

# --- Docker Compose (PostgreSQL) ---
POSTGRES_DB=kiwicart
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev

# --- Frontend (Vite build-time variables) ---
VITE_AUTH0_DOMAIN=your-tenant.au.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key
VITE_API_BASE_URL=https://your-azure-app.azurewebsites.net/api

# --- Backend ---
# Backend config lives in server-dotnet/src/KiwiCart.Api/appsettings.Development.json
# See that file for ConnectionStrings, Auth0, and GoogleMaps settings.
