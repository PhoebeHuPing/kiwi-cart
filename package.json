{
  "name": "my-fullstack-collection",
  "type": "module",
  "version": "0.1.0",
  "description": "Build a fullstack collection app",
  "repository": "https://https://github.com/dev-academy-challenges/my-fullstack-collection",
  "main": "server/index.ts",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "npm-run-all --parallel dev:client dev:server",
    "dev:dotnet": "VITE_SERVER_PORT=5000 npm-run-all --parallel dev:client dev:server:dotnet",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:server:dotnet": "cd server-dotnet/src/KiwiCart.Api && dotnet watch run",
    "build": "run-s build:client build:server",
    "build:client": "vite build",
    "build:server": "esbuild --packages=external --platform=node --format=esm --outfile=dist/server.js --bundle server/index.ts",
    "test": "vitest",
    "knex": "NODE_OPTIONS='--import tsx' knex --knexfile ./server/db/knexfile.ts",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "format": "prettier -w '**/*.{js,jsx,ts,tsx}'",
    "render:build": "npm install && npm run build && npm prune --omit=dev && NODE_ENV='production' npm run knex migrate:latest",
    "render:start": "node dist/server.js"
  },
  "keywords": [
    "fullstack"
  ],
  "author": "Dev Academy Aotearoa",
  "license": "ISC",
  "eslintConfig": {
    "extends": "@devacademy/eslint-config-react",
    "ignorePatterns": [
      "bundle.js"
    ]
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.17.0",
    "@devacademy/eslint-config": "^1.10.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "express-oauth2-jwt-bearer": "^1.9.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "knex": "^2.5.1",
    "pg": "^8.20.0",
    "react-hot-toast": "^2.6.0",
    "sqlite3": "^5.1.7",
    "superagent": "^10.2.2",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@devacademy/eslint-config": "^1.10.2",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/eslint-plugin-query": "^5.12.2",
    "@tanstack/react-query": "^5.12.2",
    "@tanstack/react-query-devtools": "^5.13.3",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/superagent": "^8.1.1",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.27.2",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.1.1",
    "nock": "^14.0.5",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.12",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.13.0",
    "sass": "^1.50.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "sqlite3": {
      "node-gyp": "12.2.0",
      "tar": "7.5.7"
    }
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "browserslist": "> 2%, not dead"
}
